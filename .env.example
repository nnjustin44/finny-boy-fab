# Copy to .env for local Docker Compose use. Never put real production secrets here.
HOST_PORT=8080
SPRING_PROFILES_ACTIVE=prod
SITE_BASE_URL=http://localhost:8080
APP_BASE_URL=http://localhost:8080
SUPPORT_EMAIL=finnyboyfab@gmail.com

# Checkout stays off by default. Production enablement belongs in the hosting secret/config service.
CHECKOUT_ENABLED=false
MADE_TO_ORDER=false
LAUNCH_REVIEWED=false
STRIPE_AUTOMATIC_TAX_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

NEWSLETTER_ENABLED=false
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
